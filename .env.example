# Development / local
APP_ENV=development
APP_NAME=A-Tex InfiDrive

# Слушать можно через SERVER_* или устаревший YTDRIVE_ADDR
SERVER_HOST=127.0.0.1
SERVER_PORT=8092
# YTDRIVE_ADDR=127.0.0.1:8092

PUBLIC_URL=http://localhost:8092

STORAGE_PATH=data
# DATABASE_PATH=data/ytdrive.db
# TEMP_PATH=data/tmp
# YTDRIVE_DATA_DIR=data

UPLOAD_MAX_MB=50
# Алиас / уточнение для large-files (МиБ):
# MAX_UPLOAD_MIB=50
# MAX_CHUNK_MIB=5
# MAX_TEMP_MIB=1024
# MAX_ACTIVE_ENCODERS=1
# MAX_ACTIVE_DECODERS=1
# YOUTUBE_WAIT_PROCESSING_SEC=1800
MAX_CONCURRENT_JOBS=1
# YTDRIVE_MAX_UPLOAD_MB=64
# YTDRIVE_WORKERS=1
YTDRIVE_QUEUE=16

FFMPEG_PATH=
FFPROBE_PATH=
# YTDRIVE_FFMPEG=
# YTDRIVE_FFPROBE=

# Single-admin (для локальной защиты). В development можно задать ADMIN_PASSWORD.
# В production — только ADMIN_PASSWORD_HASH (см. go run ./cmd/hashpw).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# ADMIN_PASSWORD_HASH=

# Не короче 32 символов. В production запрещены слабые/тестовые значения.
SESSION_SECRET=dev-session-secret-change-me-32chars
# 32 байта: hex (64 символа), base64 или raw длиной 32
TOKEN_ENCRYPTION_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8092/api/youtube/callback

# Объектное хранилище (не используется при EXPERIMENTAL_YOUTUBE_STORE=true).
STORAGE_PROVIDER=memory

# --- Experimental YouTube E2E (колледжный demo) ---
# EXPERIMENTAL_YOUTUBE_STORE=true
# STORAGE_BACKEND=youtube
# YOUTUBE_PRIVACY=private
# для demo можно public — не меняет default private
# YOUTUBE_PRIVACY=public
# CONTENT_ENCRYPTION_KEY=  # openssl rand -hex 32
# Лимит полезной нагрузки experimental YouTube store (КиБ; 51200 = 50 МиБ).
# EXPERIMENTAL_MAX_KB=51200
# SSYOUTUBE_API_URL=        # legacy HTTP endpoint (обычно пусто)
# Playwright browser-retriever (SSYouTube UI):
# BROWSER_RETRIEVER_JS=browser-retriever/src/cli.mjs
# BROWSER_RETRIEVER_TEMP=   # на VPS: /dev/shm/infidrive (tmpfs)
# BROWSER_RETRIEVER_TIMEOUT_SEC=180
# BROWSER_RETRIEVER_HEADLESS=true

# S3 (если не experimental YouTube):
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=


# Опционально
# YTDRIVE_WEB_DIR=
# SITE_DIR=site
