# Адрес сервера
YTDRIVE_ADDR=:8080

# Каталог SQLite и пользовательских файлов. Не публикуйте его через веб-сервер.
YTDRIVE_DATA_DIR=data

# Каталог HTML. Пустое значение — ./web рядом с запуском.
YTDRIVE_WEB_DIR=

# Лимит загрузки, мегабайты. Относится и к исходному файлу, и к MP4 для восстановления.
YTDRIVE_MAX_UPLOAD_MB=64

# Сколько заданий FFmpeg может выполняться одновременно.
YTDRIVE_WORKERS=1

# Длина очереди заданий.
YTDRIVE_QUEUE=16

# Пути к утилитам. Пусто или ffmpeg/ffprobe — искать в PATH.
YTDRIVE_FFMPEG=ffmpeg
YTDRIVE_FFPROBE=ffprobe

# Параметры кодирования для веб-заданий.
YTDRIVE_FPS=10
YTDRIVE_CRF=16
YTDRIVE_GOP=1
YTDRIVE_PRESET=veryfast
YTDRIVE_FRAME_REPEAT=2
YTDRIVE_PACKET_REPEAT=2
YTDRIVE_PARITY_GROUP=8
YTDRIVE_GZIP=false
