# Development / local
APP_ENV=development
APP_NAME=A-Tex InfiDrive

# Слушать можно через SERVER_* или устаревший YTDRIVE_ADDR
SERVER_HOST=127.0.0.1
SERVER_PORT=8092
# YTDRIVE_ADDR=127.0.0.1:8092

PUBLIC_URL=http://localhost:8092

STORAGE_PATH=data
# DATABASE_PATH=data/ytdrive.db
# TEMP_PATH=data/tmp
# YTDRIVE_DATA_DIR=data

UPLOAD_MAX_MB=64
MAX_CONCURRENT_JOBS=1
# YTDRIVE_MAX_UPLOAD_MB=64
# YTDRIVE_WORKERS=1
YTDRIVE_QUEUE=16

FFMPEG_PATH=
FFPROBE_PATH=
# YTDRIVE_FFMPEG=
# YTDRIVE_FFPROBE=

# Single-admin (для локальной защиты). В development можно задать ADMIN_PASSWORD.
# В production — только ADMIN_PASSWORD_HASH (см. go run ./cmd/hashpw).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# ADMIN_PASSWORD_HASH=

# Не короче 32 символов. В production запрещены слабые/тестовые значения.
SESSION_SECRET=dev-session-secret-change-me-32chars
# 32 байта: hex (64 символа), base64 или raw длиной 32
TOKEN_ENCRYPTION_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8092/api/youtube/callback

# Опционально
# YTDRIVE_WEB_DIR=
# SITE_DIR=site
