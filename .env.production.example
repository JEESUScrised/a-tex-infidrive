# Production — скопируйте в /etc/infidrive/env и заполните реальными секретами.
# Файл с секретами НЕ коммитить.

APP_ENV=production
APP_NAME=A-Tex InfiDrive

SERVER_HOST=127.0.0.1
SERVER_PORT=8092
PUBLIC_URL=https://app.a-tex-infidrive.ru

STORAGE_PATH=/var/lib/infidrive
DATABASE_PATH=/var/lib/infidrive/ytdrive.db
TEMP_PATH=/var/lib/infidrive/tmp

UPLOAD_MAX_MB=50
MAX_UPLOAD_MIB=50
MAX_CHUNK_MIB=5
MAX_TEMP_MIB=1024
MAX_ACTIVE_ENCODERS=1
MAX_ACTIVE_DECODERS=1
YOUTUBE_WAIT_PROCESSING_SEC=1800
EXPERIMENTAL_YOUTUBE_STORE=true
EXPERIMENTAL_MAX_KB=51200
YOUTUBE_PRIVACY=public
MAX_CONCURRENT_JOBS=1
YTDRIVE_QUEUE=16

# Системный FFmpeg на Linux
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

ADMIN_USERNAME=admin
# go run ./cmd/hashpw 'ваш-пароль'
ADMIN_PASSWORD_HASH=

# openssl rand -base64 48
SESSION_SECRET=

# openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://app.a-tex-infidrive.ru/api/youtube/callback

YTDRIVE_WEB_DIR=/opt/infidrive/current/frontend/dist

# Пользовательские файлы только во внешнем S3/R2 — не на диске VPS.
STORAGE_PROVIDER=s3
S3_ENDPOINT=https://xxx.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PREFIX=infidrive
